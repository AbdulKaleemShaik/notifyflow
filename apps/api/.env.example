# ============================================================
# NotifyFlow API — Environment Variable Reference
# Copy this file to `.env` and fill in your values.
# ============================================================

# MongoDB
MONGO_URI=mongodb://mongo:27017/notifyflow

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT — use long, random strings (min 64 chars each)
JWT_SECRET=change_this_to_a_long_random_string_min_64_chars
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string

# Email — fallback SMTP (tenants can override with their own)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
SMTP_FROM=notifications@notifyflow.local

# AWS
AWS_ACCOUNT_ID=
AWS_REGION=ap-south-1
S3_BUCKET=notifyflow-logs

# App
NODE_ENV=development
PORT=3000
